<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hiero.ecom</groupId>
        <artifactId>hiero-ecom</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>hiero-ecom.all</artifactId>
    <packaging>zip</packaging>
    <name>Hiero eCommerce - All Package</name>
    <dependencies>
        <dependency>
            <groupId>com.hiero.ecom</groupId>
            <artifactId>hiero-ecom.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hiero.ecom</groupId>
            <artifactId>hiero-ecom.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.hiero.ecom</groupId>
            <artifactId>hiero-ecom.ui.frontend</artifactId>
            <version>${project.version}</version>
            <classifier>clientlib</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.hiero.ecom</groupId>
            <artifactId>hiero-ecom.ui.config</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.hiero.ecom</groupId>
            <artifactId>hiero-ecom.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <version>1.0.4</version>
                <extensions>true</extensions>
                <configuration>
                    <group>com.hiero.ecom</group>
                    <name>hiero-ecom-all</name>
                    <packageType>application</packageType>
                    <embeddeds>
                        <embedded>
                            <groupId>com.hiero.ecom</groupId>
                            <artifactId>hiero-ecom.core</artifactId>
                            <type>jar</type>
                            <target>/apps/hiero-ecom/install</target>
                        </embedded>
                    </embeddeds>
                    <subPackages>
                        <subPackage>
                            <groupId>com.hiero.ecom</groupId>
                            <artifactId>hiero-ecom.ui.apps</artifactId>
                            <type>zip</type>
                        </subPackage>
                        <subPackage>
                            <groupId>com.hiero.ecom</groupId>
                            <artifactId>hiero-ecom.ui.config</artifactId>
                            <type>zip</type>
                        </subPackage>
                        <subPackage>
                            <groupId>com.hiero.ecom</groupId>
                            <artifactId>hiero-ecom.ui.content</artifactId>
                            <type>zip</type>
                        </subPackage>
                    </subPackages>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>