{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["main/ts/components/*"],
      "@services/*": ["main/ts/shared/services/*"],
      "@patterns/*": ["main/ts/patterns/*"],
      "@types/*": ["main/ts/types/*"]
    }
  },
  "include": ["src/main/ts/**/*"],
  "exclude": ["node_modules", "dist", "src/test"]
}