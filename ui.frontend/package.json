{
  "name": "hiero-ecommerce-ui-frontend",
  "version": "1.0.0",
  "description": "Frontend assets for Hiero eCommerce",
  "scripts": {
    "build": "tsc && sass src/main/scss:dist/css && node scripts/build.js",
    "build:watch": "concurrently \"tsc -w\" \"sass --watch src/main/scss:dist/css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "dev": "npm run build:watch"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/vitest": "^1.1.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.1.5",
    "concurrently": "^8.2.2",
    "happy-dom": "^12.10.3",
    "sass": "^1.69.5",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
