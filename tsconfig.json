{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["ui.frontend/src/main/*"],
      "@test/*": ["ui.frontend/src/test/*"]
    }
  },
  "include": ["ui.frontend/src/main/**/*", "ui.frontend/src/test/**/*"],
  "exclude": ["node_modules", "dist"]
}
